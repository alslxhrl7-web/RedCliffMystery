MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 2e9837e75e6400a419be66cd7a079d15, type: 3}
  m_Name: Dialogue_Seolpyeong
  m_EditorClassIdentifier: Assembly-CSharp::RedCliffMystery.Dialogue.CharacterDialogueData
  characterId: seolpyeong
  displayName: "\uC124\uD3C9"
  introLines:
  - speakerName: "\uC124\uD3C9"
    text: "\uC544\uC774\uACE0, \uC624\uC168\uC2B5\uB2C8\uAE4C. \uBB38\uC11C\uACE0 \uC77C\uC774\uB77C\uBA74 \uC81C\uAC00 \uC81C\uC77C \uC798 \uC54C\uC9C0\uC694. \uBB50\uB4E0 \uBB3C\uC5B4\uBCF4\uC2ED\uC2DC\uC624."
  - speakerName: "\uC124\uD3C9"
    text: "\uC774\uB7F0 \uC77C\uC774 \uC0DD\uACA8\uC11C \uC800\uB3C4 \uBC24\uC7A0\uC744 \uC124\uCE69\uB2C8\uB2E4. \uC5BC\uB978 \uBC94\uC778\uC744 \uC7A1\uC544\uC57C \uD560 \uD150\uB370\uC694..."
  topics:
  - topicId: sp_archive
    buttonLabel: "\uBB38\uC11C\uACE0 \uAD00\uB9AC"
    visibilityConditions: []
    lines:
    - speakerName: "\uC124\uD3C9"
      text: "\uADF8 \uBB38\uC11C\uB294 \uC81C\uAC00 \uB9E4\uC77C \uC810\uAC80\uD558\uB358 \uAC83\uC785\uB2C8\uB2E4. \uADF8\uB0A0\uB3C4 \uBD84\uBA85 \uC81C\uC790\uB9AC\uC5D0 \uC788\uC5C8\uB294\uB370..."
    effectsOnFirstView: []
    hideAfterFirstView: 0
  - topicId: sp_hometown
    buttonLabel: "\uACE0\uD5A5/\uC774\uB984"
    visibilityConditions: []
    lines:
    - speakerName: 
      text: "\uADF8\uB7EC\uACE0 \uBCF4\uB2C8 \uC124 \uC11C\uAE30\uB294 \uACE0\uD5A5\uC774 \uC5B4\uB514\uC600\uC18C?"
    - speakerName: "\uC124\uD3C9"
      text: "(\uC6C3\uC73C\uBA70) \uC800 \uAC19\uC740 \uBBF8\uCC9C\uD55C \uC0AC\uB78C \uACE0\uD5A5 \uC774\uC57C\uAE30\uAC00 \uBB50 \uADF8\uB9AC \uC911\uC694\uD558\uACA0\uC2B5\uB2C8\uAE4C. \uADF8\uB0E5 \uD754\uD55C \uC2DC\uACE8 \uB9C8\uC744\uC785\uB2C8\uB2E4."
    effectsOnFirstView: []
    hideAfterFirstView: 0
  - topicId: sp_final_confrontation
    buttonLabel: "[\uACB0\uC815\uC801 \uC2EC\uBB38] \uC815\uCCB4\uB97C \uCD94\uAD81\uD55C\uB2E4"
    visibilityConditions:
    - type: 3
      key: clue_household_registry_no_record
    - type: 3
      key: clue_wu_secret_letter_true_name
    lines:
    - speakerName: 
      text: "\uC124\uD3C9... \uADF8\uB300\uC758 \uACE0\uD5A5\uC774\uB77C\uB294 \uB9C8\uC744 \uD638\uC801\uC744 \uB2E4 \uB4A4\uC838\uBD24\uB124. \uADF8\uB7F0\uB370 \uADF8\uB7F0 \uC774\uB984\uC73C\uB85C \uD0DC\uC5B4\uB09C \uC790\uAC00 \uC5C6\uB354\uAD70."
    - speakerName: "\uC124\uD3C9"
      text: "(\uD45C\uC815\uC774 \uC21C\uAC04 \uAD73\uC5C8\uB2E4\uAC00 \uB2E4\uC2DC \uC6C3\uB294\uB2E4) \uD638\uC801\uC774\uC57C \uC804\uB780 \uD1B5\uC5D0 \uC18C\uC2E4\uB418\uB294 \uACBD\uC6B0\uAC00 \uC6CC\uB099 \uB9CE\uC9C0 \uC54A\uC2B5\uB2C8\uAE4C. \uADF8\uB7F0 \uAC78\uB85C \uC0AC\uB78C\uC744 \uC758\uC2EC\uD558\uC2DC\uBA74..."
    - speakerName: 
      text: "\uADF8\uB7FC \uC774\uAC74 \uC5B4\uB5BB\uAC8C \uC124\uBA85\uD558\uACA0\uB098. \uC624\uB098\uB77C\uC640 \uC624\uAC04 \uC11C\uC2E0 \uC18D\uC5D0 '\uBAA9\uC5F0'\uC774\uB77C\uB294 \uC774\uB984\uC774 \uC801\uD600 \uC788\uB354\uAD70."
    - speakerName: "\uC124\uD3C9"
      text: "(\uAE34 \uCE68\uBB35. \uC6C3\uC74C\uAE30\uAC00 \uC644\uC804\uD788 \uC0AC\uB77C\uC9C4\uB2E4) ...\uBAA9\uC5F0. \uADF8 \uC774\uB984\uC744 \uBD80\uB974\uB294 \uAC83\uB3C4 \uCC38 \uC624\uB79C\uB9CC\uC774\uAD70\uC694."
    - speakerName: "\uC124\uD3C9"
      text: "\uC124\uD3C9\uC774\uB77C\uB294 \uC774\uB984\uC740... \uADF8\uC800 \uC544\uBB34\uB3C4 \uB208\uC5EC\uACA8\uBCF4\uC9C0 \uC54A\uC744 \uC774\uB984\uC774 \uD544\uC694\uD574\uC11C \uACE8\uB790\uC744 \uBFD0\uC785\uB2C8\uB2E4. \uB108\uBB34 \uD754\uD558\uACE0, \uB108\uBB34 \uD3C9\uBC94\uD574\uC11C \uC544\uBB34\uB3C4 \uC758\uC2EC\uD558\uC9C0 \uC54A\uC744 \uC774\uB984."
    - speakerName: "\uC124\uD3C9"
      text: "\uD654\uBAA9\uD568\uC744 \uD37C\uB728\uB9AC\uB77C\uACE0 \uC9C0\uC5B4\uC8FC\uC2E0 \uC774\uB984\uC778\uB370... \uACB0\uAD6D\uC740 \uC774\uB7F0 \uC2DD\uC73C\uB85C \uC18C\uC2DD\uC744 \uD37C\uB728\uB9AC\uB294 \uC790\uAC00 \uB418\uC5C8\uAD70\uC694. \uC544\uC774\uB7EC\uB2C8\uD558\uC9C0 \uC54A\uC2B5\uB2C8\uAE4C?"
    - speakerName: "\uBAA9\uC5F0"
      text: "\uC774\uC81C \uC640\uC11C \uBD80\uC778\uD558\uC9C0\uB294 \uC54A\uACA0\uC2B5\uB2C8\uB2E4. \uC608, \uC81C\uAC00 \uADF8 \uBB38\uC11C\uB97C \uB118\uACBC\uC2B5\uB2C8\uB2E4. \uAC15\uB3D9\uC744 \uC704\uD574\uC11C."
    effectsOnFirstView:
    - type: 1
      key: seolpyeong_exposed
    hideAfterFirstView: 1
  evidencePresentations: []
