%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: d0fcfa9cae33a5e4e800b1ad60d92691, type: 3}
  m_Name: FinalAccusationDialogueSet
  m_EditorClassIdentifier: Assembly-CSharp::RedCliffMystery.Dialogue.FinalAccusationDialogueSet
  openingLines:
  - speakerName: "\uC870\uC870"
    text: "\uC870\uC0AC\uB97C \uB05D\uB0C8\uB2E4\uACE0 \uB4E4\uC5C8\uB2E4."
  - speakerName: "\uC870\uC870"
    text: "\uB9D0\uD574\uB77C. \uBC94\uC778\uC740 \uB204\uAD6C\uB0D0?"
  caimaoNoEvidenceLines:
  - speakerName: 
    text: "\uCC44\uBAA8\uC640 \uC7A5\uC724\uC785\uB2C8\uB2E4."
  - speakerName: "\uC870\uC870"
    text: "\uB450 \uC0AC\uB78C\uC744 \uBC94\uC778\uC73C\uB85C \uC9C0\uBAA9\uD558\uB294 \uAC83\uC774\uB0D0?"
  - speakerName: 
    text: "\uADF8\uB807\uC2B5\uB2C8\uB2E4."
  - speakerName: "\uC870\uC870"
    text: "\uADFC\uAC70\uB294?"
  - speakerName: 
    text: "...\uC9C0\uAE08\uAE4C\uC9C0 \uC870\uC0AC\uD55C \uC815\uD669\uC744 \uC885\uD569\uD558\uBA74 \uB450 \uC0AC\uB78C\uC774 \uAC00\uC7A5 \uC758\uC2EC\uC2A4\uB7FD\uC2B5\uB2C8\uB2E4."
  - speakerName: "\uB098\uB808\uC774\uC158"
    text: "\uC870\uC870\uC758 \uD45C\uC815\uC774 \uAD73\uC5B4\uC9C4\uB2E4."
  - speakerName: "\uC870\uC870"
    text: "\uC815\uD669?"
  - speakerName: "\uC870\uC870"
    text: "\uB0B4\uAC00 \uB108\uC5D0\uAC8C \uB9E1\uAE34 \uAC83\uC740 \uC758\uC2EC\uD560 \uC0AC\uB78C\uC744 \uACE0\uB974\uB294 \uC77C\uC774 \uC544\uB2C8\uC5C8\uB2E4."
  - speakerName: "\uC870\uC870"
    text: "\uBC94\uC778\uC744 \uCC3E\uC544\uB0B4\uB77C\uACE0 \uD588\uB2E4."
  - speakerName: 
    text: "\uD558\uC9C0\uB9CC\u2014"
  - speakerName: "\uC870\uC870"
    text: "\uACB0\uC815\uC801\uC778 \uC99D\uAC70\uB294 \uC788\uB290\uB0D0?"
  - speakerName: 
    text: "...\uC5C6\uC2B5\uB2C8\uB2E4."
  - speakerName: "\uB098\uB808\uC774\uC158"
    text: "\uC7A0\uC2DC \uCE68\uBB35."
  - speakerName: "\uC870\uC870"
    text: "\uADF8\uB807\uB2E4\uBA74 \uB124\uAC00 \uC9C0\uAE08 \uB0B4 \uC55E\uC5D0\uC11C \uD55C \uB9D0\uC740 \uBB34\uC5C7\uC774\uC9C0?"
  - speakerName: 
    text: ......
  - speakerName: "\uC870\uC870"
    text: "\uADFC\uAC70 \uC5C6\uB294 \uC9C0\uBAA9\uC73C\uB85C \uB0B4 \uC7A5\uC218\uB97C \uC8FD\uAC8C \uD560 \uC148\uC774\uB0D0?"
  - speakerName: "\uB098\uB808\uC774\uC158"
    text: "\uC870\uC870\uAC00 \uBCD1\uC0AC\uB4E4\uC5D0\uAC8C \uACE0\uAC1C\uB97C \uB044\uB355\uC778\uB2E4."
  - speakerName: "\uC870\uC870"
    text: "\uB354 \uC774\uC0C1 \uB9E1\uAE38 \uC218 \uC5C6\uB2E4."
  - speakerName: "\uC870\uC870"
    text: "\uB370\uB824\uAC00\uB77C."
  - speakerName: 
    text: "\uC7A0\uC2DC\uB9CC! \uC544\uC9C1 \uD655\uC778\uD558\uC9C0 \uBABB\uD55C \uAC83\uC774\u2014"
  - speakerName: "\uC870\uC870"
    text: "\uC774\uBBF8 \uB2A6\uC5C8\uB2E4."
  - speakerName: "\uB098\uB808\uC774\uC158"
    text: "\uD654\uBA74 \uC554\uC804."
  caimaoWrongEvidenceLines:
  - speakerName: 
    text: "\uCC44\uBAA8\uC640 \uC7A5\uC724\uC774 \uBC94\uC778\uC785\uB2C8\uB2E4."
  - speakerName: "\uC870\uC870"
    text: "\uC99D\uAC70\uB294?"
  - speakerName: "\uB098\uB808\uC774\uC158"
    text: "\uD50C\uB808\uC774\uC5B4\uAC00 \uC99D\uAC70\uB97C \uB0B4\uBBFC\uB2E4."
  - speakerName: 
    text: "\uC774\uAC83\uC785\uB2C8\uB2E4."
  - speakerName: "\uB098\uB808\uC774\uC158"
    text: "\uC870\uC870\uAC00 \uC99D\uAC70\uB97C \uCC9C\uCC9C\uD788 \uC0B4\uD3B4\uBCF8\uB2E4."
  - speakerName: "\uC870\uC870"
    text: "\uC774\uAC83\uC774 \uB450 \uC0AC\uB78C\uC774 \uBB38\uC11C\uB97C \uD6D4\uCCE4\uB2E4\uB294 \uC99D\uAC70\uB77C\uACE0?"
  - speakerName: 
    text: "\uADF8\uB807\uC2B5\uB2C8\uB2E4."
  - speakerName: "\uB098\uB808\uC774\uC158"
    text: "\uC870\uC870\uAC00 \uACE0\uAC1C\uB97C \uB4E0\uB2E4."
  - speakerName: "\uC870\uC870"
    text: "\uC544\uB2C8\uB2E4."
  - speakerName: 
    text: "...\uC608?"
  - speakerName: "\uC870\uC870"
    text: "\uC774 \uC99D\uAC70\uB9CC\uC73C\uB85C\uB294 \uBB38\uC11C\uC758 \uB3C4\uB09C\uACFC \uB450 \uC0AC\uB78C\uC744 \uC5F0\uACB0\uD560 \uC218 \uC5C6\uB2E4."
  - speakerName: 
    text: "\uD558\uC9C0\uB9CC \uC774 \uC815\uD669\uC740\u2014"
  - speakerName: "\uC870\uC870"
    text: "\uC815\uD669\uACFC \uC99D\uAC70\uB97C \uD63C\uB3D9\uD558\uC9C0 \uB9C8\uB77C."
  - speakerName: "\uB098\uB808\uC774\uC158"
    text: "\uC7A0\uC2DC \uCE68\uBB35."
  - speakerName: "\uC870\uC870"
    text: "\uB124\uAC00 \uB4E4\uACE0 \uC628 \uAC83\uC740 \uC758\uC2EC\uC744 \uB4B7\uBC1B\uCE68\uD560 \uBFD0\uC774\uB2E4."
  - speakerName: "\uC870\uC870"
    text: "\uBC94\uD589\uC744 \uC99D\uBA85\uD558\uC9C0\uB294 \uBABB\uD55C\uB2E4."
  - speakerName: 
    text: ......
  - speakerName: "\uC870\uC870"
    text: "\uC774\uB7F0 \uC99D\uAC70\uB97C \uAC00\uC9C0\uACE0 \uB0B4 \uC7A5\uC218\uB97C \uBC94\uC778\uC774\uB77C \uC9C0\uBAA9\uD588\uB2E4\uB294 \uAC83\uC774\uB0D0?"
  - speakerName: "\uB098\uB808\uC774\uC158"
    text: "\uC870\uC870\uC758 \uBAA9\uC18C\uB9AC\uAC00 \uCC28\uAC11\uAC8C \uBCC0\uD55C\uB2E4."
  - speakerName: "\uC870\uC870"
    text: "\uB124 \uD310\uB2E8 \uD558\uB098\uB85C \uC0AC\uB78C\uC758 \uBAA9\uC228\uC774 \uC624\uAC04\uB2E4."
  - speakerName: "\uC870\uC870"
    text: "\uADF8 \uBB34\uAC8C\uB97C \uC54C\uACE0\uB3C4 \uC774\uB7F0 \uD310\uB2E8\uC744 \uB0B4\uB9B0 \uAC83\uC774\uB0D0?"
  - speakerName: "\uB098\uB808\uC774\uC158"
    text: "\uD50C\uB808\uC774\uC5B4\uAC00 \uC544\uBB34 \uB9D0\uB3C4 \uD558\uC9C0 \uBABB\uD55C\uB2E4."
  - speakerName: "\uC870\uC870"
    text: "\uB370\uB824\uAC00\uB77C."
  - speakerName: "\uB098\uB808\uC774\uC158"
    text: "\uD654\uBA74 \uC554\uC804."
  caimaoWrongfulExecutionLines:
  - speakerName: 
    text: "\uBC94\uC778\uC740 \uCC44\uBAA8\uC640 \uC7A5\uC724\uC785\uB2C8\uB2E4."
  - speakerName: "\uC870\uC870"
    text: "\uD655\uC2E4\uD55C\uAC00?"
  - speakerName: 
    text: "\uC608."
  - speakerName: "\uC870\uC870"
    text: "\uC99D\uAC70\uB97C \uB0B4\uB193\uC544\uB77C."
  - speakerName: "\uB098\uB808\uC774\uC158"
    text: "\uD50C\uB808\uC774\uC5B4\uAC00 \uC900\uBE44\uD55C \uC99D\uAC70\uB97C \uD558\uB098\uC529 \uB0B4\uB193\uB294\uB2E4."
  - speakerName: "\uB098\uB808\uC774\uC158"
    text: "\uC870\uC870\uAC00 \uC99D\uAC70\uB97C \uD655\uC778\uD55C\uB2E4."
  - speakerName: "\uB098\uB808\uC774\uC158"
    text: "\uC7A0\uC2DC \uCE68\uBB35."
  - speakerName: "\uC870\uC870"
    text: "...\uC774 \uC815\uB3C4\uB77C\uBA74."
  - speakerName: "\uB098\uB808\uC774\uC158"
    text: "\uC870\uC870\uAC00 \uCC44\uBAA8\uC640 \uC7A5\uC724\uC744 \uBC14\uB77C\uBCF8\uB2E4."
  - speakerName: "\uC870\uC870"
    text: "\uCC44\uBAA8. \uC7A5\uC724."
  - speakerName: "\uCC44\uBAA8"
    text: ......
  - speakerName: "\uC7A5\uC724"
    text: "\uB9D0\uB3C4 \uC548 \uB429\uB2C8\uB2E4."
  - speakerName: "\uCC44\uBAA8"
    text: "\uC8FC\uACF5, \uC800\uD76C\uB294 \uACB0\uCF54 \uADF8\uB7F0 \uC77C\uC744 \uD558\uC9C0 \uC54A\uC558\uC2B5\uB2C8\uB2E4."
  - speakerName: "\uC870\uC870"
    text: "\uADF8\uB807\uB2E4\uBA74 \uC774\uAC83\uC744 \uC5B4\uB5BB\uAC8C \uC124\uBA85\uD560 \uAC83\uC774\uB0D0?"
  - speakerName: "\uB098\uB808\uC774\uC158"
    text: "\uCC44\uBAA8\uB294 \uC544\uBB34 \uB9D0\uB3C4 \uD558\uC9C0 \uBABB\uD55C\uB2E4."
  - speakerName: "\uC7A5\uC724"
    text: "\uC800\uD76C\uB294 \uACB0\uBC31\uD569\uB2C8\uB2E4!"
  - speakerName: "\uC870\uC870"
    text: "\uB04C\uACE0 \uAC00\uB77C."
  - speakerName: "\uCC44\uBAA8"
    text: "\uC8FC\uACF5!"
  - speakerName: "\uC7A5\uC724"
    text: "\uD55C \uBC88\uB9CC \uB354 \uC870\uC0AC\uD574 \uC8FC\uC2ED\uC2DC\uC624!"
  - speakerName: "\uB098\uB808\uC774\uC158"
    text: "\uB450 \uC0AC\uB78C\uC774 \uB04C\uB824 \uB098\uAC04\uB2E4."
  - speakerName: "\uB098\uB808\uC774\uC158"
    text: "[\uBA70\uCE60 \uD6C4 \u2014 \uBB38\uC11C\uACE0]"
  - speakerName: "\uB098\uB808\uC774\uC158"
    text: "\uBCD1\uC0AC\uAC00 \uAE09\uD558\uAC8C \uC870\uC870\uC5D0\uAC8C \uB2EC\uB824\uC628\uB2E4."
  - speakerName: "\uBCD1\uC0AC"
    text: "\uC8FC\uACF5!"
  - speakerName: "\uC870\uC870"
    text: "\uBB34\uC2A8 \uC77C\uC774\uB0D0?"
  - speakerName: "\uBCD1\uC0AC"
    text: "\uBB38\uC11C\uACE0\uB97C \uB2E4\uC2DC \uD655\uC778\uD588\uC9C0\uB9CC... \uD654\uACF5\uB300\uBE44\uCC45\uC740 \uBC1C\uACAC\uB418\uC9C0 \uC54A\uC558\uC2B5\uB2C8\uB2E4."
  - speakerName: "\uB098\uB808\uC774\uC158"
    text: "\uC870\uC870\uC758 \uD45C\uC815\uC774 \uAD73\uC5B4\uC9C4\uB2E4."
  - speakerName: "\uC870\uC870"
    text: "\uBB50\uB77C\uACE0?"
  - speakerName: "\uBCD1\uC0AC"
    text: "\uC5B4\uB514\uC5D0\uB3C4 \uC5C6\uC2B5\uB2C8\uB2E4."
  - speakerName: "\uB098\uB808\uC774\uC158"
    text: "\uCE68\uBB35."
  - speakerName: "\uB098\uB808\uC774\uC158"
    text: "\uC870\uC870\uAC00 \uCC9C\uCC9C\uD788 \uD50C\uB808\uC774\uC5B4\uB97C \uBC14\uB77C\uBCF8\uB2E4."
  - speakerName: "\uC870\uC870"
    text: "\uCC44\uBAA8\uC640 \uC7A5\uC724\uC744 \uCC98\uD615\uD588\uB2E4."
  - speakerName: "\uC870\uC870"
    text: "\uADF8\uB7F0\uB370 \uBB38\uC11C\uB294 \uC544\uC9C1 \uC0AC\uB77C\uC9C4 \uCC44\uB2E4."
  - speakerName: 
    text: "...\uADF8\uB7F4 \uB9AC\uAC00 \uC5C6\uC2B5\uB2C8\uB2E4."
  - speakerName: "\uC870\uC870"
    text: "\uADF8\uB807\uB2E4\uBA74 \uD558\uB098\uBFD0\uC774\uB2E4."
  - speakerName: "\uC870\uC870"
    text: "\uB124\uAC00 \uD2C0\uB838\uB2E4."
  - speakerName: "\uB098\uB808\uC774\uC158"
    text: "\uD50C\uB808\uC774\uC5B4\uAC00 \uC544\uBB34 \uB9D0\uB3C4 \uD558\uC9C0 \uBABB\uD55C\uB2E4."
  - speakerName: "\uC870\uC870"
    text: "\uB124\uAC00 \uAC00\uC838\uC628 \uC99D\uAC70\uB294 \uB450 \uC0AC\uB78C\uC744 \uC758\uC2EC\uD558\uAC8C \uB9CC\uB4E4\uC5C8\uC744 \uBFD0\uC774\uB2E4."
  - speakerName: "\uC870\uC870"
    text: "\uD558\uC9C0\uB9CC \uC9C4\uC9DC \uBC94\uC778\uC740 \uB530\uB85C \uC788\uC5C8\uB2E4."
  - speakerName: 
    text: ......
  - speakerName: "\uC870\uC870"
    text: "\uB108\uB294 \uBC94\uC778\uC744 \uCC3E\uACA0\uB2E4\uACE0 \uB098\uC130\uB2E4."
  - speakerName: "\uC870\uC870"
    text: "\uADF8\uB9AC\uACE0 \uB0B4 \uC7A5\uC218 \uB458\uC744 \uC8FD\uAC8C \uB9CC\uB4E4\uC5C8\uB2E4."
  - speakerName: "\uC870\uC870"
    text: "\uADF8 \uCC45\uC784\uC744 \uD53C\uD560 \uC218 \uC788\uC744 \uAC83 \uAC19\uC73C\uB0D0?"
  - speakerName: 
    text: "\uC8FC\uACF5, \uD55C \uBC88\uB9CC \uB354 \uAE30\uD68C\uB97C \uC8FC\uC2ED\uC2DC\uC624."
  - speakerName: "\uC870\uC870"
    text: "\uAE30\uD68C?"
  - speakerName: "\uB098\uB808\uC774\uC158"
    text: "\uC870\uC870\uAC00 \uCC28\uAC11\uAC8C \uBC14\uB77C\uBCF8\uB2E4."
  - speakerName: "\uC870\uC870"
    text: "\uB124\uAC8C\uB294 \uC774\uBBF8 \uCDA9\uBD84\uD55C \uC2DC\uAC04\uC774 \uC788\uC5C8\uB2E4."
  - speakerName: "\uC870\uC870"
    text: "\uB370\uB824\uAC00\uB77C."
  - speakerName: 
    text: "\uC7A0\uC2DC\uB9CC!"
  - speakerName: "\uB098\uB808\uC774\uC158"
    text: "\uD654\uBA74 \uC554\uC804."
  - speakerName: "\uB098\uB808\uC774\uC158"
    text: "[\uC801\uBCBD \u2014 \uAC19\uC740 \uB0A0 \uBC24]"
  - speakerName: "\uB098\uB808\uC774\uC158"
    text: "\uBA40\uB9AC\uC11C \uB2E4\uAE09\uD55C \uBAA9\uC18C\uB9AC\uAC00 \uB4E4\uB824\uC628\uB2E4."
  - speakerName: "\uBCD1\uC0AC"
    text: "\uD654\uC120\uC774\uB2E4!"
  - speakerName: "\uBCD1\uC0AC 2"
    text: "\uBD88\uC774 \uBD99\uC5C8\uC2B5\uB2C8\uB2E4!"
  - speakerName: "\uBCD1\uC0AC"
    text: "\uBC30\uAC00 \uC6C0\uC9C1\uC774\uC9C0 \uC54A\uC2B5\uB2C8\uB2E4!"
  - speakerName: "\uBCD1\uC0AC 2"
    text: "\uC1E0\uC0AC\uC2AC\uC744 \uB04A\uC5B4\uB77C!"
  - speakerName: "\uB098\uB808\uC774\uC158"
    text: "\uBD88\uAE38\uC774 \uBE60\uB974\uAC8C \uBC88\uC9C4\uB2E4."
  - speakerName: "\uBCD1\uC0AC"
    text: "\uBD88\uAE38\uC774 \uB108\uBB34 \uBE60\uB985\uB2C8\uB2E4!"
  - speakerName: "\uB098\uB808\uC774\uC158"
    text: "\uD568\uC120\uB4E4\uC774 \uC5F0\uB2EC\uC544 \uBD88\uD0C0\uC624\uB978\uB2E4."
  - speakerName: "\uB098\uB808\uC774\uC158"
    text: "[\uC870\uC870\uC758 \uD0C8\uCD9C]"
  - speakerName: "\uB098\uB808\uC774\uC158"
    text: "\uC870\uC870\uAC00 \uBD88\uD0C0\uB294 \uD568\uB300\uB97C \uBC14\uB77C\uBCF8\uB2E4."
  - speakerName: "\uC870\uC870"
    text: "...\uC774 \uBAA8\uB4E0 \uAC83\uC774."
  - speakerName: "\uB098\uB808\uC774\uC158"
    text: "\uC7A0\uC2DC \uCE68\uBB35."
  - speakerName: "\uC870\uC870"
    text: "\uC774\uBBF8 \uC2DC\uC791\uB41C \uC77C\uC774\uC5C8\uB2E8 \uB9D0\uC778\uAC00."
  - speakerName: "\uB098\uB808\uC774\uC158"
    text: "\uC870\uC870\uAC00 \uB4A4\uB97C \uB3CC\uC544\uBCF8\uB2E4."
  - speakerName: "\uC870\uC870"
    text: "\uD1F4\uAC01\uD55C\uB2E4."
  - speakerName: "\uB098\uB808\uC774\uC158"
    text: "[\uB9C8\uC9C0\uB9C9 \uC7A5\uBA74]"
  - speakerName: "\uB098\uB808\uC774\uC158"
    text: "\uBD88\uD0C0\uB294 \uC801\uBCBD. \uCE74\uBA54\uB77C\uB294 \uCC9C\uCC9C\uD788 \uBB38\uC11C\uACE0\uB85C \uC774\uB3D9\uD55C\uB2E4."
  - speakerName: "\uB098\uB808\uC774\uC158"
    text: "\uD654\uACF5\uB300\uBE44\uCC45\uC774 \uC788\uB358 \uC790\uB9AC. \uD145 \uBE44\uC5B4 \uC788\uB2E4."
  - speakerName: "\uB098\uB808\uC774\uC158"
    text: "\uBC14\uB2E5\uC5D0\uB294 \uC791\uC740 \uC885\uC774 \uC870\uAC01 \uD558\uB098\uB9CC \uB0A8\uC544 \uC788\uB2E4."
  - speakerName: "\uB098\uB808\uC774\uC158"
    text: "\uD654\uBA74\uC774 \uCC9C\uCC9C\uD788 \uC5B4\uB450\uC6CC\uC9C4\uB2E4."
  - speakerName: "\uB098\uB808\uC774\uC158"
    text: "\"\uBC94\uC778\uC744 \uCC3E\uC558\uB2E4\uACE0 \uBBFF\uC5C8\uB2E4.\""
  - speakerName: "\uB098\uB808\uC774\uC158"
    text: "\uC7A0\uC2DC \uC815\uC801."
  - speakerName: "\uB098\uB808\uC774\uC158"
    text: "\"\uADF8\uB7EC\uB098 \uADF8\uAC83\uC740 \uB610 \uB2E4\uB978 \uC624\uD310\uC774\uC5C8\uB2E4.\""
  - speakerName: "\uB098\uB808\uC774\uC158"
    text: "\"\uC9C4\uC2E4\uC740 \uC544\uC9C1 \uBAA8\uC2B5\uC744 \uB4DC\uB7EC\uB0B4\uC9C0 \uC54A\uC558\uB2E4.\""
  - speakerName: "\uB098\uB808\uC774\uC158"
    text: "\uD654\uBA74 \uC554\uC804."
  dusukDocumentLostLines:
  - speakerName: "\uB098\uB808\uC774\uC158"
    text: "[\uCD5C\uC885 \uC2EC\uBB38 \u2014 \uB450\uC11D \uC9C0\uBAA9]"
  - speakerName: "\uC870\uC870"
    text: "\uBC94\uC778\uC740 \uB204\uAD6C\uB77C \uC0DD\uAC01\uD558\uB290\uB0D0?"
  - speakerName: 
    text: "\uB450\uC11D\uC785\uB2C8\uB2E4."
  - speakerName: "\uC870\uC870"
    text: "\uADFC\uAC70\uB294?"
  - speakerName: 
    text: "\uB450\uC11D\uC740 \uC0AC\uAC74\uC774 \uBC1C\uC0DD\uD55C \uBC24, \uC790\uC2E0\uC758 \uD589\uC801\uC5D0 \uB300\uD574 \uAC70\uC9D3\uB9D0\uC744 \uD588\uC2B5\uB2C8\uB2E4."
  - speakerName: "\uC870\uC870"
    text: "\uADF8 \uC774\uC720\uB294 \uD655\uC778\uD588\uB290\uB0D0?"
  - speakerName: 
    text: "\uD655\uC778\uD588\uC2B5\uB2C8\uB2E4. \uADF8\uB294 \uADFC\uBB34\uC9C0\uB97C \uC774\uD0C8\uD574 \uB3C4\uBC15\uC744 \uD588\uACE0, \uADF8\uAC83\uC744 \uC228\uAE30\uAE30 \uC704\uD574 \uAC70\uC9D3\uB9D0\uC744 \uD588\uC2B5\uB2C8\uB2E4."
  - speakerName: "\uC870\uC870"
    text: "\uADF8\uB807\uB2E4\uBA74 \uADF8 \uAC70\uC9D3\uB9D0\uC774 \uBB38\uC11C\uB97C \uD6D4\uCCE4\uB2E4\uB294 \uC99D\uAC70\uB294 \uC544\uB2C8\uC9C0 \uC54A\uB290\uB0D0?"
  - speakerName: 
    text: "\uD558\uC9C0\uB9CC \uADF8\uC758 \uD589\uC801\uC5D0\uB294 \uBD84\uBA85\uD55C \uACF5\uBC31\uC774 \uC788\uC2B5\uB2C8\uB2E4."
  - speakerName: 
    text: "\uADF8\uB9AC\uACE0 \uBB38\uC11C\uAC00 \uC0AC\uB77C\uC9C4 \uC2DC\uAC04\uACFC\uB3C4 \uC77C\uCE58\uD569\uB2C8\uB2E4."
  - speakerName: "\uC870\uC870"
    text: "\u2026\u2026."
  - speakerName: 
    text: "\uADF8\uAC00 \uBC94\uC778\uC774 \uC544\uB2C8\uB77C\uBA74, \uB204\uAD70\uAC00 \uBB38\uC11C\uB97C \uD6D4\uCCD0\uAC04 \uC0AC\uC2E4\uC744 \uC124\uBA85\uD560 \uC218 \uC5C6\uC2B5\uB2C8\uB2E4."
  - speakerName: "\uB098\uB808\uC774\uC158"
    text: "\uC870\uC870\uAC00 \uB450\uC11D\uC744 \uBC14\uB77C\uBCF8\uB2E4."
  - speakerName: "\uC870\uC870"
    text: "\uB450\uC11D."
  - speakerName: "\uB450\uC11D"
    text: "\uB300\uC7A5\uAD70\u2026\u2026 \uC800\uB294 \uB3C4\uBC15\uC744 \uD55C \uAC83\uC740 \uC0AC\uC2E4\uC785\uB2C8\uB2E4."
  - speakerName: "\uB450\uC11D"
    text: "\uD558\uC9C0\uB9CC \uBB38\uC11C\uB294 \uD6D4\uCE58\uC9C0 \uC54A\uC558\uC2B5\uB2C8\uB2E4."
  - speakerName: "\uC870\uC870"
    text: "\uB124\uAC00 \uC790\uB9AC\uB97C \uBE44\uC6B4 \uC0AC\uC2E4\uC740 \uD655\uC778\uB418\uC5C8\uB2E4."
  - speakerName: "\uC870\uC870"
    text: "\uADF8 \uC2DC\uAC04 \uB3D9\uC548 \uBB38\uC11C\uACE0\uC5D0\uC11C \uBB34\uC2A8 \uC77C\uC774 \uC788\uC5C8\uB294\uC9C0 \uC124\uBA85\uD560 \uC218 \uC788\uB290\uB0D0?"
  - speakerName: "\uB450\uC11D"
    text: "\u2026\u2026\uD560 \uC218 \uC5C6\uC2B5\uB2C8\uB2E4."
  - speakerName: "\uB098\uB808\uC774\uC158"
    text: "\uC7A0\uC2DC \uCE68\uBB35."
  - speakerName: "\uC870\uC870"
    text: "\uCC98\uD615\uD558\uB77C."
  - speakerName: "\uB450\uC11D"
    text: "\uB300\uC7A5\uAD70! \uC800\uB294 \uC815\uB9D0\u2014!"
  - speakerName: "\uB098\uB808\uC774\uC158"
    text: "\uBCD1\uC0AC\uB4E4\uC774 \uB450\uC11D\uC744 \uB04C\uACE0 \uB098\uAC04\uB2E4."
  - speakerName: "\uB098\uB808\uC774\uC158"
    text: "[\uBA70\uCE60 \uD6C4]"
  - speakerName: "\uB098\uB808\uC774\uC158"
    text: "\uBB38\uC11C\uACE0."
  - speakerName: "\uB098\uB808\uC774\uC158"
    text: "\uD50C\uB808\uC774\uC5B4\uAC00 \uC11C\uB958\uC640 \uC7A5\uBD80\uB97C \uB2E4\uC2DC \uD655\uC778\uD55C\uB2E4."
  - speakerName: 
    text: "\u2026\u2026\uC5C6\uB2E4."
  - speakerName: 
    text: "\uB450\uC11D\uC774 \uBC94\uC778\uC774\uB77C\uBA74 \uBB38\uC11C\uB294 \uC5EC\uAE30\uB85C \uB3CC\uC544\uC640 \uC788\uC5B4\uC57C \uD558\uB294\uB370\u2026\u2026."
  - speakerName: "\uB098\uB808\uC774\uC158"
    text: "\uBB38\uC11C\uACE0\uB294 \uC5EC\uC804\uD788 \uBE44\uC5B4 \uC788\uB2E4."
  - speakerName: 
    text: "\uB300\uCCB4 \uC5B4\uB514\uB85C \uC0AC\uB77C\uC9C4 \uAC70\uC9C0\u2026\u2026?"
  - speakerName: "\uB098\uB808\uC774\uC158"
    text: "[\uB77C\uC774\uBC8C \uB4F1\uC7A5]"
  - speakerName: "\uC720\uC131"
    text: "\uC544\uC9C1\uB3C4 \uCC3E\uACE0 \uC788\uC5C8\uB098?"
  - speakerName: 
    text: "\uC720\uC131\u2026\u2026."
  - speakerName: "\uC720\uC131"
    text: "\uB450\uC11D\uC740 \uC8FD\uC5C8\uB2E4."
  - speakerName: "\uC720\uC131"
    text: "\uADF8\uB7F0\uB370 \uBB38\uC11C\uB294 \uCC3E\uC9C0 \uBABB\uD588\uC9C0."
  - speakerName: 
    text: "\u2026\u2026."
  - speakerName: "\uC720\uC131"
    text: "\uB300\uC7A5\uAD70\uAED8\uC11C\uB294 \uBC94\uC778\uC744 \uC7A1\uC73C\uB77C\uACE0 \uBA85\uD558\uC168\uB2E4."
  - speakerName: "\uC720\uC131"
    text: "\uADF8\uB7F0\uB370 \uB124\uAC00 \uAC00\uC838\uC628 \uAC83\uC740 \uC8C4\uC778\uC758 \uBAA9 \uD558\uB098\uBFD0\uC774\uB2E4."
  - speakerName: 
    text: "\uB098\uB294 \uB450\uC11D\uC758 \uD589\uC801\uACFC \uC99D\uAC70\uB97C \uBAA8\uB450 \uD655\uC778\uD588\uB2E4."
  - speakerName: "\uC720\uC131"
    text: "\uADF8\uB798\uC11C?"
  - speakerName: 
    text: "\u2026\u2026."
  - speakerName: "\uC720\uC131"
    text: "\uBB38\uC11C\uB294 \uC5EC\uC804\uD788 \uC5C6\uB2E4."
  - speakerName: "\uC720\uC131"
    text: "\uACB0\uAD6D \uB124\uAC00 \uC99D\uBA85\uD55C \uAC83\uC740 \uB450\uC11D\uC774 \uC218\uC0C1\uD588\uB2E4\uB294 \uC0AC\uC2E4\uBFD0\uC774\uB2E4."
  - speakerName: 
    text: "\uADF8\uAC74\u2026\u2026."
  - speakerName: "\uC720\uC131"
    text: "\uC804\uC7C1\uC744 \uC55E\uB450\uACE0 \uC911\uC694\uD55C \uBB38\uC11C \uD558\uB098\uAC00 \uC0AC\uB77C\uC84C\uB2E4."
  - speakerName: "\uC720\uC131"
    text: "\uADF8\uB9AC\uACE0 \uADF8 \uBB38\uC11C\uB97C \uCC3E\uC73C\uB77C\uB294 \uBA85\uC744 \uBC1B\uC740 \uC790\uAC00 \uC544\uBB34\uAC83\uB3C4 \uCC3E\uC544\uB0B4\uC9C0 \uBABB\uD588\uB2E4."
  - speakerName: "\uB098\uB808\uC774\uC158"
    text: "\uC720\uC131\uC774 \uB0AE\uAC8C \uC6C3\uB294\uB2E4."
  - speakerName: "\uC720\uC131"
    text: "\uB300\uC7A5\uAD70\uAED8\uC11C \uB108\uB97C \uACC4\uC18D \uACC1\uC5D0 \uB458 \uC774\uC720\uAC00 \uC788\uC744\uAE4C?"
  - speakerName: "\uB098\uB808\uC774\uC158"
    text: "[\uC870\uC870\uC758 \uC9D1\uBB34\uC2E4]"
  - speakerName: "\uC870\uC870"
    text: "\uB124\uAC00 \uB450\uC11D\uC744 \uC9C0\uBAA9\uD55C \uADFC\uAC70\uC5D0\uB294 \uBB38\uC81C\uAC00 \uC5C6\uC5C8\uB2E4."
  - speakerName: "\uC870\uC870"
    text: "\uD558\uC9C0\uB9CC \uACB0\uACFC\uAC00 \uBB34\uC5C7\uC774\uC9C0?"
  - speakerName: 
    text: "\u2026\u2026\uBB38\uC11C\uB97C \uCC3E\uC9C0 \uBABB\uD588\uC2B5\uB2C8\uB2E4."
  - speakerName: "\uC870\uC870"
    text: "\uB9DE\uB2E4."
  - speakerName: "\uC870\uC870"
    text: "\uB098\uB294 \uBC94\uC778\uC744 \uCC3E\uC73C\uB77C\uACE0 \uBA85\uD588\uB2E4."
  - speakerName: "\uC870\uC870"
    text: "\uADF8\uB9AC\uACE0 \uB108\uB294 \uBC94\uC778\uC744 \uCC98\uBC8C\uD588\uC9C0\uB9CC, \uC815\uC791 \uAC00\uC7A5 \uC911\uC694\uD55C \uAC83\uC744 \uCC3E\uC9C0 \uBABB\uD588\uB2E4."
  - speakerName: 
    text: "\uD55C \uBC88\uB9CC \uB354 \uAE30\uD68C\uB97C \uC8FC\uC2ED\uC2DC\uC624."
  - speakerName: "\uC870\uC870"
    text: "\uC774\uBBF8 \uCDA9\uBD84\uD788 \uC8FC\uC5C8\uB2E4."
  - speakerName: "\uB098\uB808\uC774\uC158"
    text: "\uC720\uC131\uC774 \uC606\uC5D0\uC11C \uC870\uC6A9\uD788 \uC785\uC744 \uC5F0\uB2E4."
  - speakerName: "\uC720\uC131"
    text: "\uB300\uC7A5\uAD70, \uB354 \uC774\uC0C1\uC758 \uC870\uC0AC\uB294 \uC704\uD5D8\uD569\uB2C8\uB2E4."
  - speakerName: "\uC720\uC131"
    text: "\uBB38\uC11C\uAC00 \uC801\uC5D0\uAC8C \uB118\uC5B4\uAC14\uB2E4\uBA74 \uC9C0\uAE08\uC774\uB77C\uB3C4 \uB300\uBE44\uCC45\uC744 \uC138\uC6CC\uC57C \uD569\uB2C8\uB2E4."
  - speakerName: "\uC870\uC870"
    text: "\u2026\u2026."
  - speakerName: "\uC870\uC870"
    text: "\uB124\uAC00 \uBB34\uB2A5\uD574\uC11C\uB77C\uACE0 \uB2E8\uC815\uD560 \uC218\uB294 \uC5C6\uB2E4."
  - speakerName: "\uC870\uC870"
    text: "\uD558\uC9C0\uB9CC \uC804\uC7C1\uC744 \uC55E\uB454 \uC9C0\uAE08, \uC2E4\uD328\uC758 \uCC45\uC784\uC744 \uB204\uAD70\uAC00\uB294 \uC838\uC57C \uD55C\uB2E4."
  - speakerName: 
    text: "\uB300\uC7A5\uAD70\u2026\u2026."
  - speakerName: "\uC870\uC870"
    text: "\uC774 \uC77C\uC5D0\uC11C \uC190\uC744 \uB5BC\uB77C."
  - speakerName: 
    text: "\uC800\uB294 \uC544\uC9C1 \uD3EC\uAE30\uD558\uC9C0 \uC54A\uC558\uC2B5\uB2C8\uB2E4!"
  - speakerName: "\uC720\uC131"
    text: "\uD3EC\uAE30\uD558\uC9C0 \uC54A\uB294 \uAC83\uACFC \uCC45\uC784\uC744 \uC9C0\uB294 \uAC83\uC740 \uB2E4\uB978 \uBB38\uC81C\uC9C0."
  - speakerName: "\uB098\uB808\uC774\uC158"
    text: "\uBCD1\uC0AC\uB4E4\uC774 \uB2E4\uAC00\uC628\uB2E4."
  - speakerName: 
    text: "\uC7A0\uAE50\uB9CC\u2026\u2026!"
  - speakerName: "\uC870\uC870"
    text: "\uB370\uB824\uAC00\uB77C."
  - speakerName: "\uB098\uB808\uC774\uC158"
    text: "[\uB9C8\uC9C0\uB9C9 \uC7A5\uBA74]"
  - speakerName: "\uB098\uB808\uC774\uC158"
    text: "\uC5B4\uB450\uC6B4 \uBCF5\uB3C4."
  - speakerName: "\uB098\uB808\uC774\uC158"
    text: "\uD50C\uB808\uC774\uC5B4\uAC00 \uB04C\uB824\uAC00\uBA70 \uB9C8\uC9C0\uB9C9\uC73C\uB85C \uBB38\uC11C\uACE0\uB97C \uBC14\uB77C\uBCF8\uB2E4."
  - speakerName: "\uB098\uB808\uC774\uC158"
    text: "\uC5F4\uB9B0 \uBB38\uC11C\uD568."
  - speakerName: "\uB098\uB808\uC774\uC158"
    text: "\uBE44\uC5B4 \uC788\uB294 \uC790\uB9AC \uD558\uB098."
  - speakerName: "\uB098\uB808\uC774\uC158"
    text: "\"\uB450\uC11D\uC758 \uC54C\uB9AC\uBC14\uC774\uB294 \uD655\uC778\uD588\uB2E4.\""
  - speakerName: "\uB098\uB808\uC774\uC158"
    text: "\"\uADF8\uC758 \uAC70\uC9D3\uB9D0\uACFC \uBC94\uD589\uC758 \uD754\uC801\uB3C4 \uBC1D\uD600\uB0C8\uB2E4.\""
  - speakerName: "\uB098\uB808\uC774\uC158"
    text: "\"\uADF8\uB7EC\uB098 \uADF8\uAC83\uB9CC\uC73C\uB85C \uC0AC\uB77C\uC9C4 \uBB38\uC11C\uC758 \uD589\uBC29\uAE4C\uC9C0 \uC54C \uC218 \uC788\uC5C8\uB358 \uAC83\uC740 \uC544\uB2C8\uC5C8\uB2E4.\""
  - speakerName: "\uB098\uB808\uC774\uC158"
    text: "\"\uBC94\uC778\uC744 \uCC98\uBC8C\uD588\uC9C0\uB9CC, \uBB38\uC11C\uB294 \uB3CC\uC544\uC624\uC9C0 \uC54A\uC558\uB2E4.\""
  - speakerName: "\uB098\uB808\uC774\uC158"
    text: "\"\uADF8\uB9AC\uACE0 \uADF8 \uC2E4\uD328\uB97C \uD2C8\uD0C0, \uB204\uAD70\uAC00\uB294 \uB098\uB97C \uC81C\uAC70\uD558\uB824 \uD588\uB2E4.\""
  - speakerName: "\uB098\uB808\uC774\uC158"
    text: "\uD654\uBA74 \uC554\uC804"
  normalEndingLines:
  - speakerName: "\uB098\uB808\uC774\uC158"
    text: "[\uCD5C\uC885 \uC2EC\uBB38]"
  - speakerName: "\uC870\uC870"
    text: "\uADF8\uB798\uC11C \uBC94\uC778\uC740 \uB204\uAD6C\uB77C\uACE0 \uC0DD\uAC01\uD558\uB290\uB0D0?"
  - speakerName: 
    text: "\uC124\uD3C9\uC785\uB2C8\uB2E4."
  - speakerName: "\uC870\uC870"
    text: "\u2026\u2026\uC124\uD3C9?"
  - speakerName: 
    text: "\uBB38\uC11C\uACE0\uB97C \uC790\uC720\uB86D\uAC8C \uB4DC\uB098\uB4E4 \uC218 \uC788\uC5C8\uACE0, \uC0AC\uAC74\uC774 \uBC1C\uC0DD\uD55C \uBC24 \uADF8\uC758 \uD589\uB3D9\uC5D0\uB3C4 \uC758\uC2EC\uC2A4\uB7EC\uC6B4 \uC810\uC774 \uC788\uC5C8\uC2B5\uB2C8\uB2E4."
  - speakerName: "\uC870\uC870"
    text: "\uADF8\uAC83\uB9CC\uC73C\uB85C \uBC94\uC778\uC774\uB77C \uD655\uC2E0\uD560 \uC218 \uC788\uB290\uB0D0?"
  - speakerName: 
    text: "\uC81C\uAC00 \uCC3E\uC544\uB0B8 \uC99D\uAC70\uB4E4\uC774 \uADF8\uB97C \uAC00\uB9AC\uD0A4\uACE0 \uC788\uC2B5\uB2C8\uB2E4."
  - speakerName: "\uB098\uB808\uC774\uC158"
    text: "\uC870\uC870\uAC00 \uC7A0\uC2DC \uC99D\uAC70\uB97C \uC0B4\uD3B4\uBCF8\uB2E4."
  - speakerName: "\uC870\uC870"
    text: "\uC124\uD3C9\uC744 \uB370\uB824\uC640\uB77C."
  - speakerName: "\uB098\uB808\uC774\uC158"
    text: "[\uC124\uD3C9 \uC2EC\uBB38]"
  - speakerName: "\uB098\uB808\uC774\uC158"
    text: "\uBCD1\uC0AC\uB4E4\uC774 \uC124\uD3C9\uC744 \uB370\uB9AC\uACE0 \uB4E4\uC5B4\uC628\uB2E4."
  - speakerName: "\uC870\uC870"
    text: "\uC124\uD3C9."
  - speakerName: "\uC124\uD3C9"
    text: "\uC608, \uB300\uC7A5\uAD70."
  - speakerName: "\uC870\uC870"
    text: "\uC0AC\uB77C\uC9C4 \uBB38\uC11C\uC5D0 \uB300\uD574 \uC54C\uACE0 \uC788\uB290\uB0D0?"
  - speakerName: "\uC124\uD3C9"
    text: "\uBAA8\uB985\uB2C8\uB2E4."
  - speakerName: 
    text: "\uAC70\uC9D3\uB9D0\uD558\uC9C0 \uB9C8\uB77C."
  - speakerName: 
    text: "\uB124\uAC00 \uBB38\uC11C\uACE0\uC5D0 \uC811\uADFC\uD560 \uC218 \uC788\uC5C8\uB2E4\uB294 \uC0AC\uC2E4\uC740 \uD655\uC778\uB410\uB2E4."
  - speakerName: "\uC124\uD3C9"
    text: "\u2026\u2026."
  - speakerName: "\uC870\uC870"
    text: "\uB300\uB2F5\uD558\uB77C."
  - speakerName: "\uC124\uD3C9"
    text: "\u2026\u2026."
  - speakerName: "\uB098\uB808\uC774\uC158"
    text: "\uC124\uD3C9\uC774 \uB05D\uB0B4 \uC785\uC744 \uB2E4\uBB38\uB2E4."
  - speakerName: "\uC870\uC870"
    text: "\uB04C\uACE0 \uAC00\uB77C."
  - speakerName: "\uC124\uD3C9"
    text: "\u2026\u2026."
  - speakerName: "\uB098\uB808\uC774\uC158"
    text: "\uBCD1\uC0AC\uB4E4\uC774 \uC124\uD3C9\uC744 \uB04C\uACE0 \uB098\uAC04\uB2E4."
  - speakerName: "\uB098\uB808\uC774\uC158"
    text: "[\uBA70\uCE60 \uD6C4 \u2014 \uC801\uBCBD]"
  - speakerName: "\uB098\uB808\uC774\uC158"
    text: "\uC804\uC7A5\uC758 \uD568\uC131."
  - speakerName: "\uB098\uB808\uC774\uC158"
    text: "\uC870\uC870\uC758 \uAD70\uC120\uB4E4\uC774 \uAC15 \uC704\uC5D0 \uB298\uC5B4\uC11C \uC788\uB2E4."
  - speakerName: "\uC870\uC870"
    text: "\uD654\uC0B4\uC744 \uC900\uBE44\uD558\uB77C!"
  - speakerName: "\uBCD1\uC0AC"
    text: "\uC608!"
  - speakerName: "\uB098\uB808\uC774\uC158"
    text: "\uC7A0\uC2DC \uD6C4, \uAC15 \uAC74\uB108\uC5D0\uC11C \uBD88\uAE38\uC774 \uBC88\uC9C0\uAE30 \uC2DC\uC791\uD55C\uB2E4."
  - speakerName: "\uBCD1\uC0AC"
    text: "\uB300\uC7A5\uAD70! \uBD88\uC785\uB2C8\uB2E4!"
  - speakerName: "\uC870\uC870"
    text: "\u2026\u2026\uBB50\uB77C\uACE0?"
  - speakerName: "\uBCD1\uC0AC"
    text: "\uC801\uAD70\uC758 \uD654\uACF5\uC785\uB2C8\uB2E4!"
  - speakerName: "\uB098\uB808\uC774\uC158"
    text: "\uBD88\uAE38\uC774 \uC5F0\uC774\uC5B4 \uAD70\uC120\uC73C\uB85C \uC62E\uACA8\uBD99\uB294\uB2E4."
  - speakerName: "\uC870\uC870"
    text: "\uB2FB\uC744 \uC62C\uB824\uB77C! \uBC30\uB97C \uC6C0\uC9C1\uC5EC\uB77C!"
  - speakerName: "\uBCD1\uC0AC"
    text: "\uBC30\uB4E4\uC774 \uC11C\uB85C \uBB36\uC5EC \uC6C0\uC9C1\uC774\uC9C0 \uC54A\uC2B5\uB2C8\uB2E4!"
  - speakerName: "\uB098\uB808\uC774\uC158"
    text: "\uD63C\uB780\uC774 \uC2DC\uC791\uB41C\uB2E4."
  - speakerName: "\uC870\uC870"
    text: "\u2026\u2026."
  - speakerName: "\uB098\uB808\uC774\uC158"
    text: "\uD50C\uB808\uC774\uC5B4\uAC00 \uBD88\uD0C0\uB294 \uAD70\uC120\uC744 \uBC14\uB77C\uBCF8\uB2E4."
  - speakerName: 
    text: "\uC124\uB9C8\u2026\u2026."
  - speakerName: 
    text: "\uC774\uAC83\uAE4C\uC9C0\uB294 \uB9C9\uC9C0 \uBABB\uD55C \uAC74\uAC00\u2026\u2026."
  - speakerName: "\uB098\uB808\uC774\uC158"
    text: "[\uD328\uBC30 \uC774\uD6C4]"
  - speakerName: "\uB098\uB808\uC774\uC158"
    text: "\uBD88\uD0C0\uBC84\uB9B0 \uAD70\uC601."
  - speakerName: "\uB098\uB808\uC774\uC158"
    text: "\uD50C\uB808\uC774\uC5B4\uC640 \uC870\uC870\uAC00 \uAC15\uC744 \uBC14\uB77C\uBCF4\uACE0 \uC788\uB2E4."
  - speakerName: "\uC870\uC870"
    text: "\uBC94\uC778\uC740 \uC7A1\uC558\uB2E4."
  - speakerName: "\uC870\uC870"
    text: "\uD558\uC9C0\uB9CC \uC774\uBBF8 \uB2A6\uC5C8\uB2E4."
  - speakerName: 
    text: "\u2026\u2026."
  - speakerName: "\uC870\uC870"
    text: "\uBB38\uC11C\uB97C \uD6D4\uCE5C \uC790\uB97C \uCC3E\uC544\uB0C8\uB2E4\uACE0 \uD574\uC11C \uC804\uC7C1\uC758 \uACB0\uACFC\uAE4C\uC9C0 \uBC14\uB00C\uB294 \uAC83\uC740 \uC544\uB2C8\uC5C8\uB2E4."
  - speakerName: 
    text: "\uC81C\uAC00 \uC870\uAE08\uB9CC \uB354 \uBE68\uB9AC\u2026\u2026."
  - speakerName: "\uC870\uC870"
    text: "\uC544\uB2C8\uB2E4."
  - speakerName: "\uC870\uC870"
    text: "\uC774\uBBF8 \uBC8C\uC5B4\uC9C4 \uC77C\uC774\uB2E4."
  - speakerName: "\uB098\uB808\uC774\uC158"
    text: "\uC870\uC870\uAC00 \uBD88\uD0C0\uBC84\uB9B0 \uD568\uB300\uB97C \uBC14\uB77C\uBCF8\uB2E4."
  - speakerName: "\uC870\uC870"
    text: "\uC6B0\uB9AC\uB294 \uD328\uD588\uB2E4."
  - speakerName: 
    text: "\u2026\u2026."
  - speakerName: "\uC870\uC870"
    text: "\uC801\uBCBD\uC5D0\uC11C\uC758 \uD328\uBC30\uB294 \uB418\uB3CC\uB9B4 \uC218 \uC5C6\uB2E4."
  - speakerName: "\uB098\uB808\uC774\uC158"
    text: "[\uB9C8\uC9C0\uB9C9 \uC7A5\uBA74]"
  - speakerName: "\uB098\uB808\uC774\uC158"
    text: "\uAC15 \uC704\uC5D0 \uB5A0 \uC788\uB294 \uC7BF\uB354\uBBF8."
  - speakerName: "\uB098\uB808\uC774\uC158"
    text: "\uD50C\uB808\uC774\uC5B4\uAC00 \uC870\uC6A9\uD788 \uBC14\uB77C\uBCF8\uB2E4."
  - speakerName: "\uB098\uB808\uC774\uC158"
    text: "\"\uBC94\uC778\uC740 \uCC3E\uC544\uB0C8\uB2E4.\""
  - speakerName: "\uB098\uB808\uC774\uC158"
    text: "\"\uC0AC\uB77C\uC9C4 \uBB38\uC11C\uC758 \uC0AC\uAC74\uC740 \uB05D\uB0AC\uB2E4.\""
  - speakerName: "\uB098\uB808\uC774\uC158"
    text: "\"\uD558\uC9C0\uB9CC \uC9C4\uC2E4\uC744 \uBC1D\uD600\uB0B4\uB294 \uAC83\uB9CC\uC73C\uB85C\uB294 \uCDA9\uBD84\uD558\uC9C0 \uC54A\uC558\uB2E4.\""
  - speakerName: "\uB098\uB808\uC774\uC158"
    text: "\"\uC774\uBBF8 \uC804\uC7C1\uC740 \uC2DC\uC791\uB418\uC5C8\uACE0, \uC801\uBCBD\uC5D0\uC11C\uC758 \uD328\uBC30\uB294 \uB3CC\uC774\uD0AC \uC218 \uC5C6\uC5C8\uB2E4.\""
  - speakerName: "\uB098\uB808\uC774\uC158"
    text: "\"\uC870\uAE08\uB9CC \uB354 \uC77C\uCC0D \uC9C4\uC2E4\uC5D0 \uB2FF\uC558\uB2E4\uBA74\u2026\u2026.\""
  - speakerName: "\uB098\uB808\uC774\uC158"
    text: "\uD654\uBA74 \uC554\uC804."
