%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 2e9837e75e6400a419be66cd7a079d15, type: 3}
  m_Name: Dialogue_Jianggan
  m_EditorClassIdentifier: Assembly-CSharp::RedCliffMystery.Dialogue.CharacterDialogueData
  characterId: jianggan
  displayName: "\uC7A5\uAC04"
  introLines:
  - speakerName: "\uC7A5\uAC04"
    text: "\uB610 \uB098\uB97C \uC758\uC2EC\uD558\uB7EC \uC628 \uAC90\uAC00... \uADF8 \uC77C \uC774\uD6C4\uB85C \uB2E4\uB4E4 \uB098\uB9CC \uBCF4\uBA74 \uADF8\uB7F0 \uB208\uC73C\uB85C \uBCF4\uB354\uAD70."
  topics:
  - topicId: jg_past
    buttonLabel: "\uACFC\uAC70 \uC704\uC870\uD3B8\uC9C0 \uC0AC\uAC74"
    visibilityConditions: []
    lines:
    - speakerName: 
      text: "\uC608\uC804\uC5D0 \uCC44\uBAA8, \uC7A5\uC724 \uB450 \uC0AC\uB78C\uC744 \uBAA8\uD568\uC5D0 \uBE60\uB728\uB9B0 \uD3B8\uC9C0 \uC0AC\uAC74\uC774 \uC788\uC5C8\uB2E4\uACE0 \uB4E4\uC5C8\uC2B5\uB2C8\uB2E4."
    - speakerName: "\uC7A5\uAC04"
      text: "...\uADF8\uAC74 \uB0B4\uAC00 \uC18D\uC544\uC11C \uBC8C\uC5B4\uC9C4 \uC77C\uC774\uB2E4. \uB098 \uC5ED\uC2DC \uC774\uC6A9\uB2F9\uD55C \uAC83\uBFD0\uC774\uC57C."
    - speakerName: "\uC7A5\uAC04"
      text: "\uADF8 \uC77C\uB85C \uC2B9\uC0C1\uAED8 \uD070 \uC2E4\uB9DD\uC744 \uC548\uACA8\uB4DC\uB838\uC9C0. \uC774\uBC88\uC5D4... \uC774\uBC88\uC5D4 \uC808\uB300 \uADF8\uB7F0 \uC2E4\uC218\uB97C \uD558\uC9C0 \uC54A\uC744 \uAC83\uC774\uB2E4."
    effectsOnFirstView: []
    hideAfterFirstView: 0
  - topicId: jg_letter
    buttonLabel: "\uAC1C\uC778 \uC11C\uC2E0"
    visibilityConditions:
    - type: 1
      key: jianggan_pressed
    lines:
    - speakerName: "\uC7A5\uAC04"
      text: "(\uD55C\uC228 \uC26C\uBA70 \uD488\uC5D0\uC11C \uD3B8\uC9C0\uB97C \uAEBC\uB0B8\uB2E4) ...\uBD80\uB044\uB7FD\uC9C0\uB9CC, \uACE0\uD5A5\uC5D0 \uC788\uB294 \uC5EC\uC778\uC5D0\uAC8C \uBCF4\uB0BC \uC11C\uC2E0\uC744 \uBB38\uC11C\uACE0 \uAD00\uB9AC\uC778\uC5D0\uAC8C \uBAB0\uB798 \uB9E1\uAE30\uB824\uB358 \uAC83\uBFD0\uC774\uC5C8\uB2E4. \uC778\uD3B8\uC774 \uB9C8\uB545\uCE58 \uC54A\uC544\uC11C..."
    - speakerName: "\uC7A5\uAC04"
      text: "\uC81C\uBC1C \uC774 \uC598\uAE30\uB294... \uB2E4\uB978 \uC774\uB4E4\uC5D0\uAC8C\uB294 \uD558\uC9C0 \uB9D0\uC544\uC8FC\uAC8C."
    effectsOnFirstView:
    - type: 3
      key: clue_jianggan_personal_letter
    - type: 1
      key: jianggan_cleared
    hideAfterFirstView: 0
  evidencePresentations:
  - requiredClueId: clue_jianggan_suspicious_visit
    buttonLabelOverride: 
    reactionLines:
    - speakerName: 
      text: "\uC0AC\uAC74 \uB2F9\uC77C, \uBB38\uC11C\uACE0\uB97C \uBC29\uBB38\uD55C \uAE30\uB85D\uC774 \uB0A8\uC544\uC788\uB358\uB370\uC694."
    - speakerName: "\uC7A5\uAC04"
      text: "(\uB2F9\uD669) \uADF8, \uADF8\uAC74... \uC544\uB2C8 \uADF8\uAC8C..."
    - speakerName: "\uC7A5\uAC04"
      text: "\uB9D0\uD558\uC9C0 \uC54A\uC73C\uB824 \uD588\uB294\uB370... \uC0AC\uC2E4 \uAC1C\uC778\uC801\uC778 \uC6A9\uBB34\uC600\uB2E4."
    effects:
    - type: 1
      key: jianggan_pressed
    oneTimeOnly: 1
